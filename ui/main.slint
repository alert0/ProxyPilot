import { Button, VerticalBox, HorizontalBox, TextEdit, TextInput } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "ProxyPilot";
    width: 1120px;
    height: 760px;
    background: #f4f6fa;

    in-out property <string> status_message: "M1：粘贴 HY2 分享链接或 Base64 内容可进行本地解析预览。";
    in-out property <string> link_input: "";
    in-out property <[string]> node_rows: [];
    in-out property <int> selected_node: -1;
    in-out property <string> rename_input: "";
    in-out property <string> node_count_text: "0";
    in-out property <string> core_path: "尚未选择 sing-box.exe";
    callback import_links(string);
    callback node_action(int, string);
    callback select_node(int);
    callback rename_node(int, string);
    callback choose_core();
    callback navigate(string);
    callback action_requested(string);

    VerticalBox {
        spacing: 0px;

        HorizontalBox {
            height: 56px;
            padding-left: 20px;
            padding-right: 20px;
            alignment: center;

            Rectangle {
                width: 30px;
                height: 30px;
                background: #2868bc;
                border-radius: 8px;
                Text {
                    text: "P";
                    color: white;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalBox {
                padding-left: 10px;
                alignment: center;
                spacing: 1px;
                Text { text: "ProxyPilot"; color: #f4f7fc; font-size: 17px; font-weight: 700; }
                Text { text: "LOCAL PROXY CONTROL"; color: #8c9bb0; font-size: 9px; }
            }

            Rectangle { horizontal-stretch: 1; }

            Text { text: "Windows Desktop  ·  M1"; color: #aab5c5; font-size: 11px; }
        }

        HorizontalBox {
            spacing: 0px;

            VerticalBox {
                width: 205px;
                padding: 14px;
                spacing: 7px;

                Text { text: "工作空间"; color: #7f8da1; font-size: 10px; }

                for item[index] in ["运行概览", "代理节点", "端口映射", "诊断与验收", "运行日志", "设置"]: Button {
                    text: item;
                    height: 38px;
                    horizontal-stretch: 1;
                    clicked => { root.navigate(item); }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    background: #202b3a;
                    border-radius: 8px;
                    height: 76px;
                    VerticalBox {
                        spacing: 5px;
                        Text { text: "sing-box 核心"; color: #e5ebf4; font-size: 12px; font-weight: 600; }
                        Text { text: "尚未连接"; color: #a3afc0; font-size: 10px; }
                        Text { text: "M1 · 导入预览阶段"; color: #e0bd77; font-size: 10px; }
                    }
                }
            }

            VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    alignment: center;
                    Text { text: "代理节点"; color: #202b3c; font-size: 25px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "导入节点"; clicked => { root.action_requested("import"); } }
                }

                Rectangle {
                    background: #fff8e9;
                    border-color: #f0dfb7;
                    border-width: 1px;
                    border-radius: 8px;
                    HorizontalBox {
                        padding: 12px;
                        spacing: 10px;
                        Text { text: "提示"; color: #98712a; font-size: 12px; font-weight: 700; }
                        Text {
                            text: root.status_message;
                            color: #866f4c;
                            font-size: 11px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle {
                    background: white;
                    border-color: #e5eaf1;
                    border-width: 1px;
                    border-radius: 9px;
                    VerticalBox {
                        padding: 14px;
                        spacing: 8px;
                        Text { text: "HY2 分享链接导入"; color: #293548; font-size: 14px; font-weight: 700; }
                        Text { text: "支持 hy2://、hysteria2:// 链接（每行一条）或 Base64 链接列表。解析在本机执行；密码不会显示在结果中。"; color: #8995a6; font-size: 10px; }
                        TextEdit {
                            text <=> root.link_input;
                            placeholder-text: "粘贴 hy2://、hysteria2:// 分享链接或 Base64 内容";
                            height: 100px;
                        }
                        HorizontalBox {
                            alignment: end;
                            Button {
                                text: "解析并预览";
                                clicked => { root.import_links(root.link_input); }
                            }
                        }
                    }
                }

                Rectangle {
                    background: white;
                    border-color: #e5eaf1;
                    border-width: 1px;
                    border-radius: 9px;
                    VerticalBox {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalBox {
                            Text { text: "本地节点清单"; color: #293548; font-size: 14px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.node_count_text + " / 10"; color: #7c899b; font-size: 11px; }
                        }
                        Text { text: "凭据存入 Windows 凭据管理器；节点清单只保存非敏感元数据。"; color: #8995a6; font-size: 10px; }
                        for row[index] in root.node_rows: HorizontalBox {
                            height: 32px;
                            Text { text: row; color: #354257; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "选择"; clicked => { root.select_node(index); } }
                            Button { text: "启用/停用"; clicked => { root.node_action(index, "toggle"); } }
                            Button { text: "删除"; clicked => { root.node_action(index, "delete"); } }
                        }
                        HorizontalBox {
                            TextInput {
                                text <=> root.rename_input;
                                placeholder-text: "输入新节点名称";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "重命名所选节点";
                                enabled: root.selected_node >= 0;
                                clicked => { root.rename_node(root.selected_node, root.rename_input); }
                            }
                        }
                    }
                }

                HorizontalBox {
                    spacing: 12px;
                    for card[index] in [
                        { title: "已导入节点", value: "00", detail: "目标 10 个" },
                        { title: "已验证出口", value: "00", detail: "真实测试尚未接入" },
                        { title: "异常节点", value: "00", detail: "无实时状态" }
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        background: white;
                        border-color: #e5eaf1;
                        border-width: 1px;
                        border-radius: 9px;
                        min-height: 105px;
                        VerticalBox {
                            padding: 14px;
                            spacing: 7px;
                            Text { text: card.title; color: #7c899b; font-size: 11px; }
                            Text { text: card.value; color: #263348; font-size: 26px; font-weight: 700; }
                            Text { text: card.detail; color: #9aa5b3; font-size: 10px; }
                        }
                    }
                }

                Rectangle {
                    background: white;
                    border-color: #e5eaf1;
                    border-width: 1px;
                    border-radius: 9px;
                    VerticalBox {
                        padding: 14px;
                        spacing: 10px;
                        HorizontalBox {
                            Text { text: "sing-box 核心 / Profile 端口绑定"; color: #293548; font-size: 14px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "选择 sing-box.exe"; clicked => { root.choose_core(); } }
                            Button { text: "生成配置预览"; clicked => { root.action_requested("config"); } }
                        }
                        Text { text: root.core_path; color: #64758d; font-size: 10px; wrap: word-wrap; }
                        HorizontalBox {
                            Button { text: "启动核心"; clicked => { root.action_requested("start"); } }
                            Button { text: "停止核心"; clicked => { root.action_requested("stop"); } }
                            Button { text: "测试出口 IP"; clicked => { root.action_requested("test"); } }
                            Button { text: "DNS 路径诊断"; clicked => { root.action_requested("dns"); } }
                        }
                        Text { text: "每个节点分配一个 127.0.0.1 SOCKS5 端口（18001–18010）。配置文件含代理凭据，仅存放在本机应用数据目录；不会上传到云端。"; color: #8995a6; font-size: 10px; wrap: word-wrap; }
                        for row[index] in root.node_rows: HorizontalBox {
                            height: 30px;
                            Text { text: row; color: #64758d; font-size: 10px; vertical-alignment: center; }
                        }
                        Text { text: "真实监听状态、出口 IP 和 DNS 结果将在 sing-box 生命周期与诊断阶段接入。"; color: #9aa5b3; font-size: 10px; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalBox {
                    Text { text: "ProxyPilot  v0.1.0"; color: #9aa5b3; font-size: 10px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "本地运行 · 不修改 v2rayN"; color: #9aa5b3; font-size: 10px; }
                }
            }
        }
    }
}
